            "google_news_url": "https://news.google.com/rss/articles/CBMiswFBVV95cUxPVWxVYUpFbDhxbE9pWDJrb21yeUJBd0VuTmM2YVFGaEdlVmVQTVhEb0dRb3BJbk5LZXRKVXE3V1lOVlhuZWVPcDhlRmJDODdBODB5blRWUVd4ZTUwLU50QkdBbUo2TXN6NHNEV1FxeEhZb09tbmlJQmVHYldVdUpmcTlJMmp5ck5rWmVYcDR1Z0VYeHZnN1FKdlZzb3VnTm5QMjZWTWIwZGFHUUZJWE45cDFXSQ?oc=5",
            "article_url": "https://www.invenglobal.com/articles/19422/spotify-to-sponsor-t1-home-ground-festival-with-lck-valorant-showdowns",
            "query_players": [

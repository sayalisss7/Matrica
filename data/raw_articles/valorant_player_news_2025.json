            "source": "Hotspawn",
            "google_news_url": "https://news.google.com/rss/articles/CBMikAFBVV95cUxPUnZHRWJUYlBTZ0x4LTU5RXRsaUJjVXk2R2lqdmhCSXBsLUhkcG9YbnVvbVNDX0pVb0JSRkZFN0c4dmFDd0hhc2kzRWt1NnIwQVl5UU5ScEt3NURDMXFOaEJwVElBMHRPVG1ycXhOWm16dXNXTmdscUlVaGQtRUUxejBXVzVZM3A4Y3oxWENHTlk?oc=5",
            "article_url": "https://www.hotspawn.com/valorant/news/hyunmin-being-able-to-play-for-drx-is-super-cool",

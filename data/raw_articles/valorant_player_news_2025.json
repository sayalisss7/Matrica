            "google_news_url": "https://news.google.com/rss/articles/CBMiqAFBVV95cUxQMDdSZ1pWM21SeXdHcHhqZmF5ejRrX0JoRWpaVE9Cbkd2aHdpTjNRUHJsTlVRd1hJOHZMMWoyTDdSTnVCd2dFR3MzQThZNmV1UnFSMWxBV2NrUGdheTJEU0dWOExfSDIxNEMwdDV0YjVYOVZHZWVRckY1LU1fMEU4Qkw2R2MzVno4SzgyU09yWE95T1RLYWF6bWYzMVpyS3Y1TW9DYTk3Xy0?oc=5",
            "article_url": "https://www.invenglobal.com/articles/19307/drx-vs-t1-to-kick-off-valorant-vct-pacific-mid-season-playoffs",
            "query_players": [
                "BuZz"

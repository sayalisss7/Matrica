            "google_news_url": "https://news.google.com/rss/articles/CBMihgFBVV95cUxQalZUendZWHRkUElHYnFTVDVqdkJkeUNkb3ZtUHdkU3RFMHVjSXRRNkJBYVJLYVFabHVEeUhHMHprNkdhaF8tTEF3NlZjcTRybWlaeHZqclNSd3dGSnlsSUNJWnVYWVVVd3M4YVRtSWZQUDhMMWQ5aWZ2a1Z5d2JqdzVKTVhxZw?oc=5",

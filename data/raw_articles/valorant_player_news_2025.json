            "article_id": "8e0bb69fc18be469",
            "title": "Demon1 Could Replace Leaf In VCT Stage 2 for G2? - India Today Gaming",
            "published_at": "Fri, 18 Jul 2025 07:00:00 GMT",
            "source": "India Today Gaming",
            "google_news_url": "https://news.google.?oc=5",
            "article_url": "https://www.indiatodaygaming.com/news/story/demon1-could-replace-leaf-in-vct-stage-2-for-g2-10134",
            "query_players": [
                "Demon1",

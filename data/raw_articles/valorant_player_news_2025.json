            "article_id": "3e93faaed0c46d14",
            "title": "Top 10 Best Valorant Players Around the World - Vocal",
            "published_at": "Thu, 28 Aug 2025 08:27:46 GMT",
            "source": "Vocal",
            "google_news_url": "https://news.google.com/rss/articles/CBMifEFVX3lxTE9QM3U4X2hHRnFNSmtnRnNMTTVnbzczUkphRkRRSXNEZENyQTlETVRlNEd5aEIzWjA4TjN1VVZwZmpneWp3bVYtaUR4RXp6SjQ2ZjZSSFg5Q2dhWE4yYm1aamlWMlZtbkdhTjZLRy1ZbW83VkxNT0dMRWxCMS0?oc=5",
            "article_url": "https://vocal.media/gamers/top-10-best-valorant-players-around-the-world",
            "query_players": [
                "Jinggg"

            "google_news_url": "https://news.google.com/rss/articles/CBMickFVX3lxTE1WZXliYkIzUk5OeUFhQTRwVzQtOXQ0aFJZS0REYXZ5azBLV0xPWEVQbUp0U055WVI4Qy1CRGtQOEFQdVo5Slh1NTB5dmVWTWMydVRhSGhHS0JVakRvbmNOMDNwc09fUkIzWXhLUmd0MlB4dw?oc=5",

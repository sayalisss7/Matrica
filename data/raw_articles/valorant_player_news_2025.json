            "source": "VPEsports",
            "google_news_url": "https://news.google.com/rss/articles/CBMid0FVX3lxTFBBaXNNQmRwXzZVVTR0X1cwWmw4WUprRi02SUpiNFpveFlsclFFTTRIbUEwNTVzanFVNnFMWjU4a3JRMEVCYkROOHZrZ3p6RnNfbjVETzBLQU1vc3lyTFNlQWRNcGw2SlkyMFFqXzAycUwydVRRUExF?oc=5",
            "article_url": "https://vpesports.com/games/valorant/ethan-contract-with-nrg-esports",

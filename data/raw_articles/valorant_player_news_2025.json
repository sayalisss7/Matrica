            "google_news_url": "https://news.google.com/rss/articles/CBMiowFBVV95cUxQdDlpLXdKUDRua1JMVExqMlVCYk5UTHp2cG1xczVwRFdVOWVtamFCTV9saXFVNWRfdTM3N0RaYVpUWHB1NF9ydkVBZURDdTZqNmVNdUp6UUJKY0VzdFRxZXo0THo3ZkJnM1FnM2FybDNmUUlTdVc3NU9RbkJjUHhaaWRDSDdBRjJrOXh3QVh5RkhiRzNUY3JTdHFDZGczaTB4eDB3?oc=5",
            "article_url": "https://thechronicle.com.ph/pinoy-rookie-patmen-makes-history-with-paper-rex-in-2025-valorant-season/",
            "query_players": [

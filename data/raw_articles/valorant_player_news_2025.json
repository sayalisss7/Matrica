            "source": "India Today Gaming",
            "google_news_url": "https://news.google.?oc=5",
            "article_url": "https://www.indiatodaygaming.com/news/story/edward-gaming-signs-zjc-ahead-of-vct-cn-stage-2-9761",
            "query_players": [
                "Jieni7",

            "google_news_url": "https://news.google.com/rss/articles/CBMijgFBVV95cUxOWnE2bzNrV2hpWGlaRVpNcHhaN2k1X0tpa0J6X3ZfUGR4QmNWdmpSMFhBdVdvRW8tUWI5cVlZQVF4RXdObmhUNnl4ZWg3SUZfMF9YMWNIblgxT2Y3b2k4ODF1Mmc1aGhONzYtMUVrN3Z5cTkzWkhtMi1qbExScGRNT1p0TDF2ZlZzWkZaby1B?oc=5",
            "article_url": "https://apptrigger.com/demon1-return-to-vct-champions-is-cut-short-by-t1-01k5zfj10jnx",
            "query_players": [

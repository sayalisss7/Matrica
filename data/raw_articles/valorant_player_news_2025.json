            "google_news_url": "https://news.google.com/rss/articles/CBMickFVX3lxTE5jNGV1RkRualc5SE1wYlVncWxoZzQ0U3p3SGhaaVA1ZUpvUHVtRGlSbGljSkt4aFFjM1cyV1d0TUlKVk0zOEVtWXlwalVMY3VpY1hfaTFVTGJoYUZYNTFqVm5uUDFZN0ptWjJ3cndPRGhwZw?oc=5",
            "article_url": "https://www.oneesports.gg/league-of-legends/t1-home-ground-2025/",

            "google_news_url": "https://news.google.com/rss/articles/CBMiigFBVV95cUxQM2wxX1g4T3dma2FsT1ZDWjU5MGZRb0dpenRnejBmNW1nY2ZSUWo2aWQ4alhQS1BRU3lEUTNnUjlaQWlMRHVFb2lUQk1UbEtiUl9lS2FrSUJpeEtiSGtMOUZIU0Q1ZDM3N2VMejBFNEtlRTBjQUpGMlkwU0dFUlY3aGhrLWlCcTRubmc?oc=5",
            "article_url": "https://playvalorant.com/en-gb/news/announcements/valorant-at-comic-con-stockholm/",
